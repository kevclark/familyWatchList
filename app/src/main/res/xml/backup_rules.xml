<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below (fullBackupContent). All user data lives in the Room DB and
     DataStore prefs; the TMDB cache is refetchable but harmless to include. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore" />
</full-backup-content>
